#!/bin/sh
# Stamps css/js versions and the service worker cache name (scripts/bump-version.sh) on every commit,
# so phones never keep old files. Enabled once per clone with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
sh scripts/bump-version.sh >/dev/null || { echo "pre-commit: bump-version.sh failed" >&2; exit 1; }
git add index.html sw.js
